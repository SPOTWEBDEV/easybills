# ==============================================
# EasyBills Frontend — Environment Configuration
# ==============================================

# Base URL of the easybills-backend PHP API (no trailing slash).
#
# Local development (PHP built-in server):
#   NEXT_PUBLIC_API_URL=http://localhost:8000
#
# Production (this project's real deployment — cPanel subdomain
# api.easybills-app.top pointed at the easybills-backend project, with
# the frontend deployed separately on Vercel at easybills-app.top):
#   NEXT_PUBLIC_API_URL=https://api.easybills-app.top
#
# On Vercel, set this in Project Settings > Environment Variables
# (NOT in this file, which isn't deployed) — it must be set at build
# time since NEXT_PUBLIC_* vars are baked into the client bundle.
NEXT_PUBLIC_API_URL=http://localhost:8000

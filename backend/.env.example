# ==============================================
# EasyBills PHP Backend — Environment Configuration
# Copy this file to .env and fill in real values.
# ==============================================

APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Lagos

# Comma-separated list of allowed origins for CORS.
# Use the exact origin(s) your Next.js frontend runs on.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Database (MySQL / MariaDB) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=easybills
DB_USERNAME=root
DB_PASSWORD=

# --- Auth / JWT ---
# Generate a long random string, e.g. `php -r "echo bin2hex(random_bytes(32));"`
JWT_SECRET=change-this-to-a-long-random-string
JWT_TTL_MINUTES=1440
JWT_ADMIN_TTL_MINUTES=480

# --- OTP ---
OTP_LENGTH=6
OTP_TTL_MINUTES=10
# In local/sandbox mode, OTPs are written to storage/logs/otp.log instead of
# being sent via SMS, and the fixed demo code below always works too.
OTP_DEMO_CODE=123456

# ==============================================
# ePINs (https://www.epins.com.ng) — upstream VTU / bills provider
# Create your API key at https://app.epins.com.ng
# ==============================================
# EPINS_MODE=sandbox uses EPINS_SANDBOX_BASE_URL, EPINS_MODE=live uses EPINS_LIVE_BASE_URL.
EPINS_MODE=sandbox
EPINS_API_KEY=your-epins-api-key-here

# Confirm the exact base URLs from your ePINs merchant dashboard / docs —
# the public documentation templates these as {{baseurl}} / {{sandboxbaseurl}}.
# https://api.epins.com.ng/core is confirmed as the documentation/root endpoint.
EPINS_LIVE_BASE_URL=https://api.epins.com.ng
EPINS_SANDBOX_BASE_URL=https://sandbox.epins.com.ng

EPINS_TIMEOUT_SECONDS=25

# ==============================================
# Paystack (https://paystack.com) — wallet funding (card / bank transfer)
# Get your keys from Dashboard > Settings > API Keys & Webhooks
# https://dashboard.paystack.com/#/settings/developer
# ==============================================
# Use your TEST keys (sk_test_... / pk_test_...) until you're ready to go live.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_TIMEOUT_SECONDS=20

# In the Paystack dashboard, set your webhook URL to:
#   https://yourdomain.com/api/v1/webhooks/paystack
# (Test mode and live mode each need this set separately.)
